GEMINI_API_KEY=tu_api_key
MODEL_CHAT=gemini-2.0-flash

# Docker / Render (opcional)
# API_PORT=8000
# PORT=8000
# RUN_INGEST_ON_START=false

# Documentos Markdown (ingesta)
# DOCUMENTS_DIR=Documentos
DOCUMENTS_RECURSIVE=true

# Chroma + embeddings locales
CHROMA_PERSIST_DIR=storage/chroma
CHROMA_COLLECTION_NAME=rag_docs
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=auto
# Opcional (recomendado para evitar límites anónimos de HF Hub)
HF_TOKEN=tu_hf_token

# Retriever (similitud coseno / relevance en [0,1] según LangChain)
RETRIEVER_K=5
RETRIEVER_SCORE_THRESHOLD=0.35
RETRIEVER_USE_DYNAMIC_K=false
RETRIEVER_FETCH_MULTIPLIER=8
RETRIEVER_FETCH_MIN=40
RETRIEVER_SUMMARY_BOOST=0.08
RETRIEVER_SUMMARY_MIN_SCORE=0.40
# RETRIEVER_USE_MMR=false
# RETRIEVER_MMR_FETCH_K=20
# RETRIEVER_MMR_LAMBDA=0.7

# LLM generación (Gemini)
LLM_TEMPERATURE=0

# Reintentos Gemini (429)
GEMINI_MAX_RETRIES=8
GEMINI_RETRY_INITIAL_DELAY_SEC=2.0
